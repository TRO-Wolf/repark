 from __future__ import annotations
 
+import json
+import os
 import re
+import time
+import warnings
 
 import pytest
 
@@ -54,6 +58,84 @@ def _explain_analyze(spark: ReparkSession, sql: str) -> str:
     return "\n".join(str(row) for row in rows)
 
 
+_OPERATOR_METRICS = re.compile(r"(\w+Exec): .*?metrics=\[([^\]]*)\]")
+
+
+def _operator_rows(plan_text: str) -> list[list[object]]:
+    rows: list[list[object]] = []
+    for match in _OPERATOR_METRICS.finditer(plan_text):
+        metrics = match.group(2)
+        spill = re.search(r"spill_count=(\d+)", metrics)
+        if spill is None:
+            continue
+        spilled = re.search(r"spilled_bytes=([\d.]+ \w+)", metrics)
+        peak = re.search(r"peak_mem_used=([\d.]+ ?\w*)", metrics)
+        rows.append(
+            [
+                match.group(1),
+                int(spill.group(1)),
+                spilled.group(1) if spilled else None,
+                peak.group(1) if peak else None,
+            ]
+        )
+    return rows
+
+
+def _status_kb(field: str) -> int:
+    with open("/proc/self/status") as handle:
+        for line in handle:
+            if line.startswith(field + ":"):
+                return int(line.split()[1])
+    return -1
+
+
+def _emit_diag(record: dict[str, object]) -> None:
+    line = "SPILLDIAG " + json.dumps(record, sort_keys=True)
+    warnings.warn(line, stacklevel=2)
+    target = os.environ.get("SPILLDIAG_FILE")
+    if target:
+        with open(target, "a") as handle:
+            handle.write(line + "\n")
+
+
+def _diag_explain(spark: ReparkSession, sql: str) -> str:
+    test = os.environ.get("PYTEST_CURRENT_TEST", "").split("::")[-1].split(" ")[0]
+    started = time.monotonic()
+    base = {
+        "test": test,
+        "worker": os.environ.get("PYTEST_XDIST_WORKER", "main"),
+        "label": os.environ.get("SPILLDIAG_LABEL", ""),
+        "pid": os.getpid(),
+        "loadavg": open("/proc/loadavg").read().split()[:3],
+        "hwm_before_kb": _status_kb("VmHWM"),
+    }
+    try:
+        text = _explain_analyze(spark, sql)
+    except Exception as error:
+        _emit_diag(
+            {
+                **base,
+                "outcome": "refused",
+                "seconds": round(time.monotonic() - started, 3),
+                "hwm_after_kb": _status_kb("VmHWM"),
+                "error": str(error)[:3000],
+            }
+        )
+        raise
+    rows = _operator_rows(text)
+    _emit_diag(
+        {
+            **base,
+            "outcome": "pass" if _max_spill_count(text) > 0 else "no_spill",
+            "seconds": round(time.monotonic() - started, 3),
+            "hwm_after_kb": _status_kb("VmHWM"),
+            "max_spill": _max_spill_count(text),
+            "operators": rows,
+        }
+    )
+    return text
+
+
 _SPILL_COUNT = re.compile(r"spill_count=(\d+)")
 
 
