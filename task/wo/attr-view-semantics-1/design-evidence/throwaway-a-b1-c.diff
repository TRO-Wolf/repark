@@ -0,0 +1,173 @@
+use std::hash::{Hash, Hasher};
+use std::ops::ControlFlow;
+use std::sync::Arc;
+
+use datafusion::arrow::datatypes::{DataType, Field, FieldRef};
+use datafusion::common::{Result, internal_datafusion_err};
+use datafusion::logical_expr::simplify::{ExprSimplifyResult, SimplifyContext};
+use datafusion::logical_expr::{
+    ColumnarValue, Expr, ReturnFieldArgs, ScalarFunctionArgs, ScalarUDF, ScalarUDFImpl, Signature,
+    Volatility,
+};
+use datafusion::prelude::SessionContext;
+use datafusion::sql::sqlparser::ast::{
+    Expr as SqlExpr, Query, SelectItem, SetExpr, Spanned, Statement, Visit, Visitor,
+};
+use datafusion::sql::sqlparser::dialect::SparkSqlDialect;
+use datafusion::sql::sqlparser::parser::Parser;
+use datafusion::sql::sqlparser::tokenizer::Location;
+use repark_core::frame_names::WRITTEN_ALIAS;
+
+#[derive(Debug)]
+struct WrittenAlias {
+    signature: Signature,
+}
+
+impl PartialEq for WrittenAlias {
+    fn eq(&self, _other: &Self) -> bool {
+        true
+    }
+}
+
+impl Eq for WrittenAlias {}
+
+impl Hash for WrittenAlias {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        WRITTEN_ALIAS.hash(state);
+    }
+}
+
+impl ScalarUDFImpl for WrittenAlias {
+    fn name(&self) -> &str {
+        WRITTEN_ALIAS
+    }
+
+    fn signature(&self) -> &Signature {
+        &self.signature
+    }
+
+    fn return_type(&self, arg_types: &[DataType]) -> Result<DataType> {
+        arg_types
+            .first()
+            .cloned()
+            .ok_or_else(|| internal_datafusion_err!("written alias takes one argument"))
+    }
+
+    fn return_field_from_args(&self, args: ReturnFieldArgs<'_>) -> Result<FieldRef> {
+        let field = args
+            .arg_fields
+            .first()
+            .ok_or_else(|| internal_datafusion_err!("written alias takes one argument"))?;
+        Ok(Arc::new(Field::new(
+            WRITTEN_ALIAS,
+            field.data_type().clone(),
+            field.is_nullable(),
+        )))
+    }
+
+    fn invoke_with_args(&self, args: ScalarFunctionArgs) -> Result<ColumnarValue> {
+        args.args
+            .into_iter()
+            .next()
+            .ok_or_else(|| internal_datafusion_err!("written alias takes one argument"))
+    }
+
+    fn simplify(&self, mut args: Vec<Expr>, _info: &SimplifyContext) -> Result<ExprSimplifyResult> {
+        if args.len() == 1 {
+            return Ok(ExprSimplifyResult::Simplified(args.remove(0)));
+        }
+        Ok(ExprSimplifyResult::Original(args))
+    }
+}
+
+pub(crate) fn register(ctx: &SessionContext) {
+    if !ctx.state().scalar_functions().contains_key(WRITTEN_ALIAS) {
+        ctx.register_udf(ScalarUDF::new_from_impl(WrittenAlias {
+            signature: Signature::any(1, Volatility::Immutable),
+        }));
+    }
+}
+
+struct Collect {
+    spans: Vec<(Location, Location)>,
+}
+
+impl Visitor for Collect {
+    type Break = ();
+
+    fn pre_visit_query(&mut self, query: &Query) -> ControlFlow<Self::Break> {
+        collect_set(&query.body, &mut self.spans);
+        ControlFlow::Continue(())
+    }
+}
+
+fn collect_set(body: &SetExpr, spans: &mut Vec<(Location, Location)>) {
+    match body {
+        SetExpr::Select(select) => {
+            for item in &select.projection {
+                if let SelectItem::ExprWithAlias { expr, .. } = item
+                    && matches!(expr, SqlExpr::Identifier(_) | SqlExpr::CompoundIdentifier(_))
+                {
+                    let span = expr.span();
+                    spans.push((span.start, span.end));
+                }
+            }
+        }
+        SetExpr::SetOperation { left, right, .. } => {
+            collect_set(left, spans);
+            collect_set(right, spans);
+        }
+        _ => {}
+    }
+}
+
+fn byte_offset(sql: &str, at: Location) -> Option<usize> {
+    let line = usize::try_from(at.line).ok()?.checked_sub(1)?;
+    let column = usize::try_from(at.column).ok()?.checked_sub(1)?;
+    let mut start = 0;
+    for (index, text) in sql.split_inclusive('\n').enumerate() {
+        if index == line {
+            return text
+                .char_indices()
+                .map(|(offset, _)| start + offset)
+                .chain(std::iter::once(start + text.len()))
+                .nth(column);
+        }
+        start += text.len();
+    }
+    (line == sql.split_inclusive('\n').count() && column == 0).then_some(sql.len())
+}
+
+pub(crate) fn mark_written_aliases(sql: &str) -> Option<String> {
+    if !sql.to_ascii_lowercase().contains("as") {
+        return None;
+    }
+    let statements = Parser::parse_sql(&SparkSqlDialect {}, sql).ok()?;
+    let [statement] = statements.as_slice() else {
+        return None;
+    };
+    if !matches!(statement, Statement::Query(_)) {
+        return None;
+    }
+    let mut collect = Collect { spans: Vec::new() };
+    let _ = statement.visit(&mut collect);
+    let mut ranges = collect
+        .spans
+        .iter()
+        .map(|(start, end)| Some((byte_offset(sql, *start)?, byte_offset(sql, *end)?)))
+        .collect::<Option<Vec<_>>>()?;
+    if ranges.is_empty() {
+        return None;
+    }
+    ranges.sort_unstable();
+    ranges.dedup();
+    let mut out = sql.to_string();
+    for (start, end) in ranges.into_iter().rev() {
+        if start >= end || end > out.len() {
+            return None;
+        }
+        out.insert(end, ')');
+        out.insert_str(start, &format!("{WRITTEN_ALIAS}("));
+    }
+    Some(out)
+}
