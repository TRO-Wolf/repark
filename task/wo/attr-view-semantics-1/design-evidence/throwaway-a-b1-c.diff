+pub const WRITTEN_ALIAS: &str = "repark_written_alias";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Located {
+    Output,
+    Hidden,
+    PullUp,
+    Absent,
+}
+
+fn join_key_holds(join: &Join, id: &AttrId) -> bool {
+    let side_holds = |side: &LogicalPlan, expr: &Expr| match expr {
+        Expr::Column(column) => side
+            .schema()
+            .index_of_column(column)
+            .ok()
+            .is_some_and(|index| AttrId::of(side.schema().field(index)).as_ref() == Some(id)),
+        _ => false,
+    };
+    join.on
+        .iter()
+        .any(|(left, right)| side_holds(&join.left, left) || side_holds(&join.right, right))
+}
+
+fn schema_holds(schema: &DFSchema, id: &AttrId) -> bool {
+    schema
+        .fields()
+        .iter()
+        .any(|field| AttrId::of(field).as_ref() == Some(id))
+}
+
+fn facade_internal(alias: &TableReference) -> bool {
+    let table = alias.table();
+    table.starts_with("__repark") || table.starts_with("_repark")
+}
+
+#[must_use]
+pub fn locate(plan: &LogicalPlan, id: &AttrId) -> Located {
+    if schema_holds(plan.schema(), id) {
+        return Located::Output;
+    }
+    let mentioned = plan
+        .exists(|node| Ok(schema_holds(node.schema(), id)))
+        .unwrap_or(true);
+    if !mentioned {
+        return Located::Absent;
+    }
+    let mut node = plan;
+    loop {
+        let next: &LogicalPlan = match node {
+            LogicalPlan::Projection(projection) => &projection.input,
+            LogicalPlan::Filter(filter) => &filter.input,
+            LogicalPlan::Sort(sort) => &sort.input,
+            LogicalPlan::Limit(limit) => &limit.input,
+            LogicalPlan::Distinct(Distinct::All(input)) => input,
+            LogicalPlan::Repartition(repartition) => &repartition.input,
+            LogicalPlan::SubqueryAlias(alias) if facade_internal(&alias.alias) => &alias.input,
+            LogicalPlan::SubqueryAlias(_)
+            | LogicalPlan::Union(_)
+            | LogicalPlan::Aggregate(_)
+            | LogicalPlan::TableScan(_)
+            | LogicalPlan::Values(_)
+            | LogicalPlan::EmptyRelation(_) => return Located::Absent,
+            _ => return Located::PullUp,
+        };
+        if schema_holds(next.schema(), id) {
+            if let LogicalPlan::Join(join) = next
+                && join_key_holds(join, id)
+            {
+                return Located::Hidden;
+            }
+            return Located::PullUp;
+        }
+        node = next;
+    }
+}
+
+fn written_marker_arg(expr: &Expr) -> Option<Expr> {
+    let Expr::ScalarFunction(function) = expr else {
+        return None;
+    };
+    if function.func.name() != WRITTEN_ALIAS || function.args.len() != 1 {
+        return None;
+    }
+    function.args.first().cloned()
+}
+
+#[allow(clippy::missing_errors_doc)]
+pub fn consume_written_aliases(plan: LogicalPlan) -> Result<LogicalPlan> {
+    plan.transform_up(|node| match node {
+        LogicalPlan::Projection(projection) => {
+            let expr = projection
+                .expr
+                .iter()
+                .map(|expr| match expr {
+                    Expr::Alias(alias) => match written_marker_arg(&alias.expr) {
+                        Some(inner) => {
+                            let mut metadata = alias.metadata.clone().unwrap_or_default();
+                            metadata.extend(AttrId::mint().metadata());
+                            Expr::Alias(Alias {
+                                expr: Box::new(inner),
+                                relation: alias.relation.clone(),
+                                name: alias.name.clone(),
+                                metadata: Some(metadata),
+                            })
+                        }
+                        None => expr.clone(),
+                    },
+                    other => other.clone(),
+                })
+                .collect::<Vec<_>>();
+            Projection::try_new(expr, Arc::clone(&projection.input))
+                .map(|rebuilt| Transformed::yes(LogicalPlan::Projection(rebuilt)))
+        }
+        other => other.recompute_schema().map(Transformed::yes),
+    })
+    .data()
+}
