+#[must_use]
+pub fn seated_frame_plan(config: &SessionConfig, frame: DataFrame) -> LogicalPlan {
+    let Some(seat) = config.get_extension::<FrameViewSeat>() else {
+        return frame.into_parts().1;
+    };
+    match seat.wrap("", &frame, config.options()).get_logical_plan() {
+        Some(plan) => plan.into_owned(),
+        None => frame.into_parts().1,
+    }
+}
