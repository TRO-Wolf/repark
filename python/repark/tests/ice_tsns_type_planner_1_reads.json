{
 "cases": {
  "h_retry:sc_209": {
   "sql": "SELECT id, sequence(coalesce({c}, {N}), coalesce({c}, {N}) + INTERVAL 2 SECOND, INTERVAL 1 SECOND) AS v FROM {S} ORDER BY id"
  },
  "h_retry:sc_210": {
   "sql": "SELECT id, sequence(coalesce({c}, {N}), {c}) AS v FROM {S} ORDER BY id"
  },
  "i_cons:us_209": {
   "sql": "SELECT id, sequence(v, v + INTERVAL 2 SECOND, INTERVAL 1 SECOND) AS r FROM (SELECT id, ntz, ts, far, {c}, {c} AS v FROM {S} UNION ALL SELECT id + 10, ntz, ts, far, {c}, {N} FROM {S}) u ORDER BY id"
  },
  "i_cons:us_210": {
   "sql": "SELECT id, sequence(v, {c}) AS r FROM (SELECT id, ntz, ts, far, {c}, {c} AS v FROM {S} UNION ALL SELECT id + 10, ntz, ts, far, {c}, {N} FROM {S}) u ORDER BY id"
  },
  "j_seq:seq_df": {
   "py": "T.select('id', F.sequence(F.coalesce(F.col('{c}'), {FN}), F.col('{c}')).alias('v')).orderBy('id')"
  },
  "j_seq:seq_df_explode": {
   "py": "T.select('id', F.explode(F.sequence(F.coalesce(F.col('{c}'), {FN}), F.col('{c}') + F.expr('INTERVAL 1 SECOND'), F.expr('INTERVAL 1 SECOND'))).alias('v')).orderBy('id', 'v')"
  },
  "j_seq:seq_site_both": {
   "sql": "SELECT id, sequence(coalesce({c}, {N}), coalesce({c}, {N})) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_case": {
   "sql": "SELECT id, sequence(CASE WHEN id > 0 THEN {c} ELSE {N} END, {c}) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_coalesce": {
   "sql": "SELECT id, sequence(coalesce({c}, {N}), {c}) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_greatest": {
   "sql": "SELECT id, sequence(greatest({c}, {N}), {c}) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_if": {
   "sql": "SELECT id, sequence(if(id > 0, {c}, {N}), {c}) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_nullif": {
   "sql": "SELECT id, sequence(nullif({c}, {N}), {c}) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_size": {
   "sql": "SELECT id, size(sequence(coalesce({c}, {N}), {c})) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_step": {
   "sql": "SELECT id, sequence(coalesce({c}, {N}), coalesce({c}, {N}) + INTERVAL 2 SECOND, INTERVAL 1 SECOND) AS v FROM {S} ORDER BY id"
  },
  "j_seq:seq_site_union": {
   "sql": "SELECT id, sequence(v, v) AS r FROM (SELECT id, {c} AS v FROM {S} UNION ALL SELECT 9, {N}) u ORDER BY id"
  },
  "j_seq:seq_site_where": {
   "sql": "SELECT id FROM {S} WHERE size(sequence(coalesce({c}, {N}), {c})) = 1 ORDER BY id"
  },
  "m_udf:udf_apply_in_pandas_site": {
   "py": "T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).groupBy('id').applyInPandas(lambda pdf: pdf, T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).schema).orderBy('id')"
  },
  "m_udf:udf_foreach_batch_like": {
   "py": "spark.createDataFrame(T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).toPandas(), T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).schema).orderBy('id')"
  },
  "m_udf:udf_map_in_arrow": {
   "py": "T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).mapInArrow(lambda it: it, 'id int, v string' if False else T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).schema).orderBy('id')"
  },
  "m_udf:udf_map_in_arrow_array": {
   "py": "T.select('id', F.array(F.col('{c}'), {FN}).alias('v')).mapInArrow(lambda it: it, T.select('id', F.array(F.col('{c}'), {FN}).alias('v')).schema).orderBy('id')"
  },
  "m_udf:udf_map_in_arrow_ddl_ltz": {
   "py": "T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).mapInArrow(lambda it: it, 'id int, v timestamp').orderBy('id')"
  },
  "m_udf:udf_map_in_pandas_site": {
   "py": "T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).mapInPandas(lambda it: it, T.select('id', F.coalesce(F.col('{c}'), {FN}).alias('v')).schema).orderBy('id')"
  }
