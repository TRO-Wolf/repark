# Editor / IDE
.vscode/

# Rust
/target/
**/*.rs.bk

# Python / uv
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
# Jupyter scratch state: examples/ notebooks are committed with outputs cleared
.ipynb_checkpoints/
dist/
build/
*.egg-info/
# Compiled native extension modules (built by maturin into the package tree)
*.so
*.pyd

# Parity golden fixtures are tracked; local scratch is not
/python/repark-parity/.scratch/

# Test-GENERATED artifact: python/repark/tests/test_pg_acceptance.py rewrites this on every
# facade run, at a path relative to the invocation CWD. Tracking it makes the suite dirty the
# tree (and CI mutate a checked-in file), so it is a run output, not a record.
/task/pg-integration-report.md

# Editor / OS
.DS_Store
*.swp

# Note: Cargo.lock IS checked in (binary workspace). uv.lock is checked in from phase 3, when
# the uv workspace members land (no uv project exists at the root until then).

# Local Spark default warehouse + Derby metastore (accidental CWD-relative Spark runs / record
# misconfig). Record driver uses a tempfile warehouse; these are run-output residue only.
/spark-warehouse/
/metastore_db/
/derby.log

# Overnight-conductor local scratch if ever materialised under the worktree (canonical scratch
# lives under /tmp/overnight-conductor/<lane>/scratch/, outside the repo).
/scratch/
